{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khoispace-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Cloudflare Workers AI: the LLM. Always talks to Cloudflare's network, even under `wrangler dev`
  // (needs `wrangler login`; usage counts against the free daily allowance of neurons).
  "ai": { "binding": "AI" },

  "vars": {
    // Browsers may call the API only from these origins (exact match, comma separated).
    "ALLOWED_ORIGINS": "https://khoispace.io.vn,http://localhost:4000,http://127.0.0.1:4000",

    // The knowledge base is read from the live site, so a site deploy updates the assistant too.
    "KB_URL": "https://khoispace.io.vn/assets/data/kb.json",

    // The answering model: any text-generation model in the Workers AI catalog (`npx wrangler ai models`).
    // Some models are paid-plan only (DeepSeek v4.1 flash returned error 5035 on the Free plan). Qwen3.8 27B works on
    // Free but is a reasoning model: roughly 150-300 neurons per answer, so ~35-60 uncached answers a day.
    // Reasoning output (<think>…</think>, `reasoning` / `reasoning_content`) never reaches visitors.
    // Cheaper alternatives: @cf/meta/llama-3.3-70b-instruct-fp8-fast, @cf/google/gemma-3-12b-it.
    "MODEL": "@cf/qwen/qwen3.8-27b",

    // Small, cheap model for the topic guardrail (ON_TOPIC / OFF_TOPIC). If it errors, the guardrail falls back to
    // MODEL (more expensive: Qwen thinks before it answers). With DEBUG_ERRORS="1" every response has an
    // `x-guard-model` header showing which model gave the verdict, so you can tell when the fallback is in use.
    "GUARD_MODEL": "@cf/meta/llama-3.1-8b-instruct",

    // "1" adds the underlying Workers AI error text to 5xx responses ({"attempts":[{model,error}]}); handy while
    // bringing a deployment up. Set to "0" once chat works.
    "DEBUG_ERRORS": "1"
  },

  // Per-IP rate limit (Workers Rate Limiting): 8 questions per minute.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4711", "simple": { "limit": 8, "period": 60 } }
  ]

  // Optional: serve it from your own domain instead of *.workers.dev (needed for the answer cache to work):
  // "routes": [{ "pattern": "ask.khoispace.io.vn", "custom_domain": true }]
}
